# ── Database Configuration ────────────────────────────────────────────────────
# PostgreSQL connection URL (e.g. for local dev running on port 5433)
DATABASE_URL="postgresql://postgres@localhost:5433/expense_tracker?schema=public"

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5002
JWT_SECRET="generate_a_secure_random_jwt_secret_min_32_chars"
REFRESH_TOKEN_SECRET="generate_a_different_secure_random_secret_min_32_chars"
CLIENT_URL="http://localhost:5173"

# ── Google OAuth Credentials ──────────────────────────────────────────────────
# Obtain from the Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure JavaScript origins include: http://localhost:5173
# Ensure redirect URIs include: http://localhost:5002/api/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── Cloudinary Credentials (Optional) ──────────────────────────────────────────
# Used for receipt scan uploads. Fallback is local storage if empty.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Gemini API Credentials (Optional) ──────────────────────────────────────────
# Used for AI vision OCR and Coach Chat. Fallback is high-fidelity mock if empty.
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
